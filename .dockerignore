# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies (at any depth: the build context is the whole repo)
node_modules
**/node_modules
.pnp
.pnp.js



# next.js
.next/
**/.next/
out/
build

# misc
.DS_Store

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*

# local env files, at any depth, so secrets never reach an image
.env
.env.*
**/.env
**/.env.*
!**/.env*.example

# turbo
.turbo
**/.turbo

# vercel
.vercel